# SafarSathi Environment Configuration

# Required: Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Assignments per Agent (Optional - defaults provided)
ORCHESTRATOR_MODEL=claude-sonnet-4-5
PLANNER_MODEL=claude-sonnet-4-5
RAG_MODEL=claude-haiku-4-5
SAFETY_MODEL=claude-haiku-4-5
ETIQUETTE_MODEL=claude-haiku-4-5

# External Tool APIs (Optional - add as keys are obtained)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
BHASHINI_API_KEY=your_bhashini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
